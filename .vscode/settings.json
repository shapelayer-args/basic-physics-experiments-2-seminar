{
  // tinymist(편집·미리보기·내보내기)가 프로젝트 fonts/의 모든 굵기를 쓰도록 고정한다.
  // 시스템 글꼴 탐색을 끄고 필요한 글꼴만 지정해, 기기와 관계없이 같은 결과를 낸다.
  // 이 값을 바꾼 뒤에는 "Typst: Restart Server"로 LSP를 재시작해야 반영된다.
  "tinymist.systemFonts": false,
  "tinymist.fontPaths": [
    "${workspaceFolder}/fonts",
    "~/Library/Fonts/",
    // 목록 기호(», ›)에 쓰는 Arial
    "/System/Library/Fonts/Supplemental/Arial.ttf"
  ]
}
